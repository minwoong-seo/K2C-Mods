<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>KingdomMenu</AssemblyName>
    <RootNamespace>KingdomMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No debug info: it would embed this PC's build path in the DLL. -->
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- The game folder to compile against and install into. By default this folder sits inside the game folder
         (Kingdom Two Crowns/KingdomMenu/src); elsewhere, build with: dotnet build -p:GameDir="D:\path\to\Kingdom Two Crowns" -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\..</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PackageDir>$(MSBuildProjectDirectory)\..\package</PackageDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Haglet-Assembly-CSharp-02.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Rewired_Core.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)\interop\Assembly-CSharp.dll')"
           Text="BepInEx interop not found in '$(BepInExDir)'. Install BepInEx 6 (IL2CPP) and the BepInEx-Fix package into the game and run it once, or pass -p:GameDir=&quot;path\to\Kingdom Two Crowns&quot;." />
  </Target>

  <!-- Put the built plugin into package/ (for copying to other PCs) and into this game's BepInEx/plugins. -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)\BepInEx\plugins\KingdomMenu" />
    <!-- The game locks the DLL while running; the package copy still succeeds, rebuild after closing the game to install. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\KingdomMenu" ContinueOnError="true" />
  </Target>

</Project>
